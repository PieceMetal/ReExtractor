<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReExtractor.Gui.EnvironmentWindow"
        Icon="/Assets/AppIcon.ico"
        Title="环境检查" Width="820" Height="430" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#16191f">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22">
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="环境检查" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="确认导出环境，然后按流程加载资源、预览模型、导出 FBX。"
                 Foreground="#9aa6b5" Margin="0,6,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#20252d" BorderBrush="#303947" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="120,*,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Blender" Foreground="#aab2c0"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BlenderStatusText" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="导出文件夹" Foreground="#aab2c0" Margin="0,9,0,0"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OutputStatusText" TextWrapping="Wrap" Margin="0,9,10,0"/>
        <Button Grid.Row="1" Grid.Column="2" Content="打开" Click="OnOpenOutputClicked" Margin="0,6,0,0" Padding="12,5"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#1b2028" BorderBrush="#303947" BorderThickness="1" CornerRadius="6" Padding="16">
      <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
          <TextBlock Text="1" FontSize="24" FontWeight="Bold" Foreground="#7fc3ff" HorizontalAlignment="Center"/>
          <TextBlock Text="下载游戏 List" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock Text="在资源里管理路径列表" Foreground="#9aa6b5" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="→" FontSize="24" Foreground="#657184" VerticalAlignment="Center" Margin="12,0"/>
        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
          <TextBlock Text="2" FontSize="24" FontWeight="Bold" Foreground="#7fc3ff" HorizontalAlignment="Center"/>
          <TextBlock Text="加载游戏资源" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock Text="选择游戏文件夹或 PAK" Foreground="#9aa6b5" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="→" FontSize="24" Foreground="#657184" VerticalAlignment="Center" Margin="12,0"/>
        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
          <TextBlock Text="3" FontSize="24" FontWeight="Bold" Foreground="#7fc3ff" HorizontalAlignment="Center"/>
          <TextBlock Text="预览资源" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock Text="双击模型或动画" Foreground="#9aa6b5" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="5" Text="→" FontSize="24" Foreground="#657184" VerticalAlignment="Center" Margin="12,0"/>
        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
          <TextBlock Text="4" FontSize="24" FontWeight="Bold" Foreground="#7fc3ff" HorizontalAlignment="Center"/>
          <TextBlock Text="导出 FBX" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock Text="模型或动画分开导出" Foreground="#9aa6b5" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="重新检测" Click="OnRefreshClicked" Padding="14,7" Margin="0,0,8,0"/>
      <Button Content="下载 Blender" Click="OnDownloadClicked" Padding="14,7" Margin="0,0,8,0"/>
      <Button Content="打开设置" Click="OnSettingsClicked" Padding="14,7" Margin="0,0,8,0" Background="#2563a8" Foreground="White"/>
      <Button Content="关闭" Click="OnCloseClicked" Padding="14,7"/>
    </StackPanel>
  </Grid>
</Window>
