<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReExtractor.Gui.AboutWindow"
        Icon="/Assets/AppIcon.ico"
        Title="关于 ReExtractor"
        Width="590" Height="540" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#16191f">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="/Assets/AppIcon.png" Width="64" Height="64"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ReExtractor" FontSize="25" FontWeight="Bold" Foreground="#7fc3ff"/>
            <TextBlock x:Name="VersionText" Foreground="#aab2c0"/>
          </StackPanel>
        </StackPanel>

        <Separator/>
        <TextBlock Text="RE 引擎资源工作台" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="面向 RE Engine 游戏的资源解包、预览与导出工作台。支持从 PAK 或已解包目录读取模型、动画、贴图和场景，并导出 UE/DCC 可用的 FBX 与 PNG。本工具不提供 Mod 编辑功能。"
                   TextWrapping="Wrap" Foreground="#d4d4d4"/>

        <Border Background="#20252d" BorderBrush="#303947" BorderThickness="1" CornerRadius="6" Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Text="当前支持" FontWeight="SemiBold" Foreground="#9cdcfe"/>
            <TextBlock Text="• PAK 扫描、路径还原、单项提取与全部解包" TextWrapping="Wrap"/>
            <TextBlock Text="• Mesh / MDF / Tex / Motlist 预览，模型组装与动画播放" TextWrapping="Wrap"/>
            <TextBlock Text="• SCN / PFB 场景解析、合并预览与场景 FBX 导出" TextWrapping="Wrap"/>
            <TextBlock Text="• List 下载管理、游戏目录自动匹配与在线更新" TextWrapping="Wrap"/>
            <TextBlock Text="• 已验证游戏：《鬼武者：剑之道》DEMO、《鬼泣 5》"
                       TextWrapping="Wrap"/>
            <TextBlock Text="  《怪物猎人：崛起》、《怪物猎人：荒野》、《街头霸王 6》"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="技术：.NET 10 · Avalonia · RE-Engine-Lib · Blender FBX" Foreground="#aab2c0"/>
        <TextBlock Text="项目与更新：https://github.com/PieceMetal/ReExtractor"
                   TextWrapping="Wrap" Foreground="#9cdcfe"/>
        <TextBlock Text="解析核心：RE-Engine-Lib（MIT License）" FontWeight="SemiBold"/>
        <SelectableTextBlock Text="https://github.com/kagenocookie/RE-Engine-Lib"
                             TextWrapping="Wrap" Foreground="#9cdcfe"/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="关闭" Click="OnCloseClicked" HorizontalAlignment="Right"
            MinWidth="92" Margin="0,18,0,0"/>
  </Grid>
</Window>
