<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <Authors>PieceMetal</Authors>
    <Description>RE Engine 资源解包、预览与 FBX 导出工具</Description>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReExtractor.Core\ReExtractor.Core.csproj" />
  </ItemGroup>

  <!-- GDeflateNet uses a native libdeflate wrapper. Keep the DLL beside the
       single-file GUI so its DllImport resolver can load compressed MHW TEX
       files after publishing (content is not embedded by IncludeNativeLibrariesForSelfExtract). -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''">
    <Content Include="..\..\GDeflateNet\GDeflateNet\runtimes\win-x64\native\libGDeflate.dll"
             Link="libGDeflate.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\export_models_fbx.py" Link="EmbeddedTools\export_models_fbx.py" />
    <EmbeddedResource Include="..\..\tools\export_animations_fbx.py" Link="EmbeddedTools\export_animations_fbx.py" />
  </ItemGroup>

  <!-- PublishSingleFile bundles ordinary Content items into the executable, but
       GDeflateNet's resolver needs the native DLL as a real neighboring file. -->
  <Target Name="CopyGDeflateNativeAfterPublish" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\GDeflateNet\GDeflateNet\runtimes\win-x64\native\libGDeflate.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemovePublishSymbols" AfterTargets="Publish">
    <Delete Files="@(ResolvedFileToPublish->WithMetadataValue('Extension', '.pdb')->'%(FullPath)')" />
    <Delete Files="$([System.IO.Directory]::GetFiles('$(PublishDir)', '*.pdb', System.IO.SearchOption.TopDirectoryOnly))" />
  </Target>
</Project>
