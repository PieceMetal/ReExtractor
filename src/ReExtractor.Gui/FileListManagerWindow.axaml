<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReExtractor.Gui.FileListManagerWindow"
        Icon="/Assets/AppIcon.ico"
        Title="管理资源路径列表" Width="1280" Height="700" MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#16191f">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="资源路径列表管理" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="管理不同 RE Engine 游戏的 .list 文件；本地列表优先于同名在线列表。"
                 Foreground="#9aa6b5" Margin="0,4,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
      <Border Grid.Column="0" Background="#20252d" BorderBrush="#303947" BorderThickness="1" CornerRadius="7" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="已安装列表" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="LocalCountText" Text="0 个" Foreground="#9aa6b5" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="打开列表文件夹" Click="OnOpenLibraryClicked" Margin="0,0,6,0"/>
              <Button Content="导入本地列表…" Click="OnImportClicked"/>
            </StackPanel>
          </Grid>
          <DataGrid Grid.Row="1" x:Name="LocalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                    CanUserReorderColumns="True" CanUserSortColumns="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="220" MinWidth="120"/>
              <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110" MinWidth="80"/>
              <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTimeText}" Width="155" MinWidth="110"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="刷新" Click="OnRefreshLocalClicked" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="删除" Click="OnDeleteClicked"/>
            <Button Grid.Column="3" Content="使用选中列表" Click="OnUseSelectedClicked"
                    Background="#2563a8" Foreground="White" Padding="13,6"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#20252d" BorderBrush="#3f5268" BorderThickness="1" CornerRadius="7" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="在线列表" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="RemoteCountText" Text="尚未获取" Foreground="#9aa6b5" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="打开完整列表仓库" Click="OnOpenFullRepositoryClicked" Margin="0,0,6,0"/>
              <Button x:Name="FetchRemoteButton" Content="刷新在线列表" Click="OnFetchRemoteClicked"/>
            </StackPanel>
          </Grid>
          <DataGrid Grid.Row="1" x:Name="RemoteGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                    CanUserReorderColumns="True" CanUserSortColumns="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="名称" Binding="{Binding Identifier}" Width="190" MinWidth="130"/>
              <DataGridTextColumn Header="来源" Binding="{Binding SourceName}" Width="150" MinWidth="100"/>
              <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" MinWidth="70"/>
              <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTimeText}" Width="155" MinWidth="110"/>
              <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="85" MinWidth="65"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" x:Name="RemoteDescriptionText" Text="选择在线列表查看说明"
                       TextTrimming="CharacterEllipsis" Foreground="#9aa6b5" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="1" x:Name="DownloadButton" Content="下载选中列表" Click="OnDownloadClicked"
                    Background="#65417f" Foreground="White" Padding="13,6"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="ManagerStatusText" Text="" Foreground="#9cdcfe" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="关闭" Click="OnCloseClicked" Padding="16,6"/>
    </Grid>
  </Grid>
</Window>
